<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  HR 企微值守通道服务的 launchd 配置模板（design.md D12）。

  ⛔ 这份文件不是能直接用的 plist：其中的占位符（形如 PYTHON、REPO_ROOT 的双花括号标记）必须由
  `tools/liaison/scripts/install_launchd.py` 渲染成绝对路径后才写进
  `~/Library/LaunchAgents/`。手抄一份改改路径也能跑，但那份就脱离了守护测试的覆盖。

  ⛔ 本文件里不出现任何密钥取值。HR_LIAISON_BOT_ID / HR_LIAISON_BOT_SECRET 由进程
  自己从仓库根 `.env` 读（tools/liaison/config.py::load_credentials），launchd 只负责
  把进程拉起来。理由：plist 落在 ~/Library/LaunchAgents/，不受 .gitignore 保护、
  会被备份链原样带走；凭据挪进 EnvironmentVariables 会静默扩大泄漏面。
  守护断言见 tests/test_liaison_boundaries.py::
  test_launchd_template_carries_variable_names_but_no_credential_values。

  ⛔ 不移植 Windows 侧的三级退避重启脚本（1min/5min/15min）——那是因为 Windows
  计划任务没有 KeepAlive 语义才自己写的，launchd 原生就有（D12）。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zhuopin.hr.liaison</string>

  <!-- 用 tools/liaison/.venv 的解释器，⛔ 不用系统 python：SDK 只装在这个 venv 里。 -->
  <key>ProgramArguments</key>
  <array>
    <string>{{PYTHON}}</string>
    <string>-m</string>
    <string>tools.liaison</string>
  </array>

  <!-- `python -m tools.liaison` 靠 cwd 进 sys.path。launchd 的默认 cwd 是 `/`，
       不钉死这一项就 import 不到 tools 包，且失败只出现在 err 日志里。 -->
  <key>WorkingDirectory</key>
  <string>{{REPO_ROOT}}</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- 进程级守护：退了就拉起来。内层断线重连是 SDK 的事（D8），这里只管进程活着。 -->
  <key>KeepAlive</key>
  <true/>

  <!-- 两次拉起之间至少隔 30s。默认是 10s——凭据缺失（退出码 2）这类必然失败的场景下
       10s 一轮会把日志刷爆。⚠️ KeepAlive=true 对退出码不作区分，配置没配好时本 job
       会一直以 30s 为周期重启；判据是 err 日志里反复出现同一条"缺凭据"。 -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- 目录不存在时 launchd 不建、也不报错，只是这条 job 起不来。安装脚本负责 mkdir。 -->
  <key>StandardOutPath</key>
  <string>{{STDOUT_LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{STDERR_LOG}}</string>
</dict>
</plist>
