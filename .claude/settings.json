{
  "model": "sonnet",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(bash docs/openers/run-lanes.sh:*)",
      "Bash(nohup bash docs/openers/run-lanes.sh:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/check-opener-header.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/limit-output.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/worktree-guard.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/context-guard.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\""
          }
        ]
      }
    ]
  }
}
